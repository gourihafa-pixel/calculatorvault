# Path (relative to project root) of the .jks keystore, and the passwords you
# typed when you generated it. Copy this file to `keystore.properties` (drop the
# `.example`) and edit the values. NEVER commit keystore.properties to Git.

storeFile=calcvault.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=calculavault
keyPassword=YOUR_KEY_PASSWORD
